# 数据库连接：开发默认 SQLite 零配置；生产用 MySQL（pymysql）
# SQLite:    sqlite:///./data/game_community.db
# MySQL 8:   mysql+pymysql://root:root@localhost:3306/game_community?charset=utf8mb4
DATABASE_URL=sqlite:///./data/game_community.db

# JWT 签名密钥（生产请改为随机长串）
JWT_SECRET_KEY=game-community-dev-secret-change-me
JWT_EXPIRE_DAYS=7

# DeepSeek：留空则 AI 三项能力走 Mock 兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
